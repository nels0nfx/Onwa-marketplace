# ONWA environment variables (v0.1.0). Copy the relevant lines; NEVER commit real values.
#   apps/api  -> create apps/api/.env          (API variables)
#   apps/web  -> create apps/web/.env.local    (WEB variables)
# On Vercel / Render set these in each service's dashboard instead of files.

# ======================= API (apps/api) - SERVER-SIDE ONLY =======================
NODE_ENV=development
PORT=4000

# Supabase project URL: Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# SECRET. Supabase service_role key: bypasses Row Level Security.
# Only the API process may hold it. Never put it in apps/web, never in NEXT_PUBLIC_*, never in git.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API. No wildcards. Production must be https.
CORS_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of the API (Render = 1). Needed for correct client IPs in rate limiting.
TRUST_PROXY_HOPS=0

RATE_LIMIT_GLOBAL_PER_15_MIN=300
RATE_LIMIT_ADMIN_WRITES_PER_MIN=20
LOG_LEVEL=info

# ======================= WEB (apps/web) =======================
# Public by design (safe in the browser bundle). This is the ANON key, not the service_role key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public URL of the website (used in email confirmation / password reset links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER-ONLY (no NEXT_PUBLIC_ prefix): base URL of the ONWA API, without /api/v1.
API_BASE_URL=http://localhost:4000

# ======================= Reserved for later stages (not used in v0.1.0) =======================
# PAYSTACK_SECRET_KEY=            # Stage 5 - server only
# PAYSTACK_WEBHOOK_SECRET=        # Stage 5 - server only
# RESEND_API_KEY=                 # Stage 8 - server only
# SENTRY_DSN=                     # Stage 10
